    "city:audit:atlas": "node scripts/build-expo-city-review-atlas.mjs",
    "city:clean:full": "powershell -ExecutionPolicy Bypass -File scripts/full_city_clean_pass.ps1 -SiteUrl \"http://localhost:5173/expo-3d?operator=1&expoData=review\" -FixSafe",
    "qa:expo-routes": "npx tsx scripts/expo-route-qa-fixtures.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:staging:preview": "node scripts/vercel-staging-preview-deploy.mjs",
    "deploy:staging:preview:prebuilt": "node scripts/vercel-staging-preview-deploy.mjs --prebuilt",
    "deploy:staging:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-staging-backend-hetzner.ps1",
    "promote:staging": "node scripts/vercel-staging-promote.mjs",
    "deploy:production:preview": "node scripts/vercel-production-preview-deploy.mjs",
    "promote:production": "node scripts/vercel-production-promote.mjs",
    "check:expo:legacy-runtime": "node scripts/pixel-streaming-smoke-check.mjs",
    "check:expo:commercial": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-warpala-commercial-demo.ps1",
    "import:legacy:sponsor-product": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/import-warpala-sponsor-product.ps1",
    "polish:legacy:booth-showroom": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-warpala-booth-showroom-polish.ps1",
    "start:expo:legacy-runtime-stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-expo-pixel-streaming-stack.ps1",
    "start:expo:legacy-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-warpala-unreal-streamer.ps1",
    "start:expo:commercial": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-warpala-commercial-demo.ps1",
    "start:backend": "cd backend-server && npm install && npm start",
    "worker:start": "cd backend-server && npm run worker",
    "check:expo-publication-staging": "node scripts/check-expo-publication-staging.mjs",
    "check:modular-home-quote-staging": "node scripts/check-modular-home-quote-staging.mjs",
    "check:expo-staging-browser-smoke": "node scripts/check-expo-staging-browser-smoke.mjs",
    "check:staging-readiness": "node scripts/check-staging-readiness.mjs"
