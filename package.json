    "build:expo-textures": "node scripts/build-expo-texture-pipeline.mjs",
    "check:expo-boundaries": "node scripts/check-expo-boundaries.mjs",
    "check:expo-release-assets": "node scripts/check-expo-release-assets.mjs",
    "check:expo-sponsor-inbox-auth": "node scripts/check-expo-sponsor-inbox-auth.mjs",
