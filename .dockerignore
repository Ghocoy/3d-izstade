node_modules
npm-debug.log
Dockerfile
.dockerignore
.git
.gitignore
.geminiignore

# Never send local secret-bearing env files to Docker build contexts.
.env
.env.*
!.env.example
!.env.*.example
backend-server/.env
backend-server/.env.*
!backend-server/.env.example
!backend-server/.env.*.example

# Ignore large folders and Unreal Engine stuff
WarpalaUE5
database
supabase
infrastructure
apps/signaling/node_modules
apps/backend/node_modules
backend-server/node_modules

# Output folders
dist
build
out

# Raw source texture pack is local intake only; release builds use expo-runtime.
public/textures/expo

# Backend local build/test/runtime artifacts are not needed by release images.
backend-server/dist
backend-server/__tests__
backend-server/routes/__tests__
backend-server/*.log

# Local hosting credentials, tunnel tokens, build staging and database fixtures.
.tmp*
.codex
.agents
