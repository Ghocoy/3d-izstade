# Set these in Render. Never put service keys in Cloudflare/frontend env.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-NEW-SUPABASE-PUBLISHABLE-KEY
SUPABASE_SERVICE_KEY=YOUR-NEW-SUPABASE-SERVER-SECRET-KEY
REDIS_URL=redis://YOUR-RENDER-INTERNAL-HOST:6379
BACKEND_CORS_ALLOWED_ORIGINS=https://YOUR-PROJECT.pages.dev
BACKEND_TRUST_PROXY_HOPS=1
APP_ENV=production
NODE_ENV=production
PIXEL_STREAMING_ROUTES_ENABLED=false
EXPO_COMMUNITY_STORAGE=supabase
MODULAR_HOME_QUOTE_SUBMISSION_ENABLED=true
MODULAR_HOME_QUOTE_PRODUCTION_HOSTS=YOUR-PROJECT.pages.dev,YOUR-API.onrender.com
MODULAR_HOME_QUOTE_EMAIL_HANDOFF_ENABLED=false
# No paid AI, Stripe live keys, GPU, worker or persistent disk in this setup.
